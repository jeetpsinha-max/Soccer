{
  "name": "peddie-soccer-gridiron",
  "version": "1.0.0",
  "private": true,
  "description": "Peddie Soccer SAC — Broadcast-Grade AI Tactical Analytics & Coaching Platform for The Peddie School Varsity Soccer Program (2026-2027 Season)",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "test": "vitest run",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node node_modules/ts-node/dist/bin.js --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset --force"
  },
  "prisma": {
    "seed": "node node_modules/ts-node/dist/bin.js --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
